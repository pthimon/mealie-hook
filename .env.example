# Copy to .env (mode 600) next to compose.yaml on marvin.

# A Mealie API token for this service. Create one in Mealie under
# Profile -> API Tokens, named "mealie-hook".
MEALIE_TOKEN=

# Optional overrides (defaults shown)
# SETTLE_SECONDS=90       # wait after an event before sweeping
# SWEEP_MINUTES=30        # safety-net sweep interval; 0 disables
# PROCESS_SINCE=          # ISO timestamp; empty = first start of the service
# REVIEW_TAG=Needs review
# PROVENANCE_TAGS=Food for Life Cookbook
# MAX_ATTEMPTS=3
# DRY_RUN=false           # true = run everything, write nothing
# LLM_MODEL=qwen
# LLM_TIMEOUT=600
